void setup() {
  // put your setup code here, to run once:
  pinMode(7, OUTPUT);
    pinMode(8, OUTPUT);
  
    // blink green LED on and off twice
  digitalWrite(7, HIGH);
        delay(200);
        digitalWrite(7, LOW);
        delay(200);
        digitalWrite(7, HIGH);
        delay(200);
        digitalWrite(7, LOW);
        delay(1000);
           // blink blue LED on and off twice
 digitalWrite(8, HIGH);
        delay(200);
        digitalWrite(8, LOW);
        delay(200);
        digitalWrite(8, HIGH);
        delay(200);
        digitalWrite(8, LOW);
        delay(3000);
}

void loop() {
    // blink both LEDs on and off alternatively
 digitalWrite(7, HIGH);
        delay(650);
        digitalWrite(7, LOW);
        delay(0);
         digitalWrite(8, HIGH);
        delay(650);
        digitalWrite(8, LOW);
        delay(0);
  

}
